{
  "name": "agentic-grove",
  "version": "0.0.1",
  "private": true,
  "description": "A desktop cockpit for running and watching AI agents",
  "license": "MIT",
  "author": "Adrian Diez Cuadrado",
  "repository": {
    "type": "git",
    "url": "https://github.com/Adiezc/agentic-grove.git"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "scan": "tsx core/cli/scan-once.ts",
    "watch": "tsx core/cli/scan-once.ts --watch",
    "usage": "tsx core/cli/usage-once.ts",
    "verify": "tsx test/verify-scan.ts",
    "verify:tells": "tsx test/verify-tells.ts",
    "verify:routing": "tsx test/verify-routing.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:tree-model": "node scripts/build-world-tree-model.mjs",
    "typecheck": "tsc --noEmit",
    "app": "bash scripts/make-app.sh"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "postprocessing": "^6.39.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  }
}
